<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mi_blue" />
                    <corners android:radius="15dp" />
                    <size android:width="48dp" android:height="30dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="20dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/thumb" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/track_off" />
                    <corners android:radius="15dp" />
                    <size android:width="48dp" android:height="30dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="20dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/thumb" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
